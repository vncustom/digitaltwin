  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.163.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261116.1": true
  }
